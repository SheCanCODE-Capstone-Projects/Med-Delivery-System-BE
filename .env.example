# Environment Variables Configuration
# =============================================================================
# MedDelivery Spring Boot - Production Environment Template
# =============================================================================
#
# Copy this file to .env and fill in your production values.
# DO NOT commit this file to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#
# IMPORTANT:
# - Keep this file secure - it contains sensitive information
# - Use Railway environment variables for production
# - Never commit .env to git
# - Rotate secrets regularly
#
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection settings
# Format: jdbc:postgresql://host:port/database
#
DB_URL=jdbc:postgresql://localhost:5432/meddelivery
DB_USERNAME=meddelivery_user
DB_PASSWORD=your-secure-password-here

# Connection Pool Settings (HikariCP)
# Optional: Uncomment to customize
# HIKARI_MAXIMUM_POOL_SIZE=20
# HIKARI_MINIMUM_IDLE=5
# HIKARI_CONNECTION_TIMEOUT=30000
# HIKARI_IDLE_TIMEOUT=600000
# HIKARI_MAX_LIFETIME=1800000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection settings
#
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis Password (if authentication is enabled)
# REDIS_PASSWORD=your-redis-password

# Redis SSL (use 'true' for secure connections)
# REDIS_SSL=false

# Redis Connection URL (alternative to host/port)
# REDIS_URL=redis://localhost:6379

# Redis Cluster Configuration (if using cluster)
# REDIS_CLUSTER_NODES=localhost:7000,localhost:7001,localhost:7002

# =============================================================================
# JWT CONFIGURATION (JSON Web Tokens)
# =============================================================================
# Security: Use a strong, randomly generated secret
# Generate with: openssl rand -base64 32
#
JWT_SECRET=your-very-secure-jwt-secret-key-minimum-32-chars-long

# Token expiration in milliseconds
# Default: 24 hours (86400000 ms)
JWT_EXPIRATION=86400000

# Refresh token expiration in milliseconds
# Default: 30 days (2592000000 ms)
JWT_REFRESH_EXPIRATION=2592000000

# JWT Issuer (optional)
# JWT_ISSUER=meddelivery.com

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
# SMTP server settings for sending emails
#
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your-email@gmail.com
spring.mail.password=your-email-password-or-app-password

# SMTP Authentication
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.ssl.trust=smtp.gmail.com

# Connection Timeout (milliseconds)
spring.mail.properties.mail.smtp.connectiontimeout=5000
spring.mail.properties.mail.smtp.timeout=5000
spring.mail.properties.mail.smtp.writetimeout=5000

# Email Sender (optional, defaults to username)
# MAIL_SENDER=noreply@meddelivery.com

# Email Templates Path
# MAIL_TEMPLATES_PATH=classpath:/mail-templates/

# =============================================================================
# OAUTH2 CONFIGURATION
# =============================================================================
# Google OAuth2 Configuration
#
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth2 Redirect URI
# Default: http://localhost:8080/login/oauth2/code/google
OAUTH2_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# Microsoft OAuth2 (optional)
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_REDIRECT_URI=http://localhost:8080/login/oauth2/code/microsoft

# GitHub OAuth2 (optional)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
# GITHUB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/github

# OAuth2 Scopes (space-separated)
# OAUTH2_SCOPES=email profile openid

# =============================================================================
# FIREBASE CONFIGURATION (Phone OTP)
# =============================================================================
# Firebase Admin SDK service account file path
# Place firebase-service-account.json in src/main/resources/
#
FIREBASE_SERVICE_ACCOUNT_PATH=classpath:firebase-service-account.json

# Firebase Project ID (optional, extracted from service account)
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase API Key (for client-side operations)
# FIREBASE_API_KEY=your-firebase-api-key

# OTP Configuration
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_DELAY_SECONDS=60

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# OTP Rate Limiting
RATE_LIMIT_OTP_SEND_MAX=3
RATE_LIMIT_OTP_SEND_WINDOW_MINUTES=15
RATE_LIMIT_OTP_VERIFY_MAX=5
RATE_LIMIT_OTP_VERIFY_WINDOW_MINUTES=15

# API Rate Limiting (global)
# RATE_LIMIT_API_REQUESTS=100
# RATE_LIMIT_API_WINDOW_MINUTES=1

# User-specific rate limits
# RATE_LIMIT_USER_REQUESTS=50
# RATE_LIMIT_USER_WINDOW_MINUTES=1

# IP-based rate limits
# RATE_LIMIT_IP_REQUESTS=200
# RATE_LIMIT_IP_WINDOW_MINUTES=1

# =============================================================================
# CORS CONFIGURATION (Cross-Origin Resource Sharing)
# =============================================================================
# Allowed origins (comma-separated)
#
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# Allowed methods
# CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH

# Allowed headers
# CORS_ALLOWED_HEADERS=*,Authorization,Content-Type,X-Requested-With

# Allow credentials
# CORS_ALLOW_CREDENTIALS=true

# Max age (seconds)
# CORS_MAX_AGE=3600

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
# Allowed WebSocket origins (comma-separated)
#
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# WebSocket endpoint
# WEBSOCKET_ENDPOINT=/ws

# WebSocket allowed origins pattern
# WEBSOCKET_ALLOWED_ORIGINS_PATTERN=**

# STOMP relay settings (if using STOMP)
# WEBSOCKET_RELAY_HOST=localhost
# WEBSOCKET_RELAY_PORT=15672
# WEBSOCKET_RELAY_USER=guest
# WEBSOCKET_RELAY_PASS=guest

# Message broker URL
# WEBSOCKET_BROKER_URL=stomp://localhost:61613

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# Upload directory location
#
APP_UPLOAD_DIR=./uploads

# Maximum file size (10MB)
spring.servlet.multipart.max-file-size=10MB

# Maximum request size (10MB)
spring.servlet.multipart.max-request-size=10MB

# Enable multipart support
spring.servlet.multipart.enabled=true

# File size threshold (1KB)
spring.servlet.multipart.file-size-threshold=1KB

# Allowed file extensions
# UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.doc,.docx

# Allowed MIME types
# UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# Scan uploaded files for viruses
# UPLOAD_SCAN_FOR_VIRUSES=true

# Maximum upload directory size (1GB)
# UPLOAD_MAX_DIRECTORY_SIZE=1073741824

# =============================================================================
# ARTIFICIAL INTELLIGENCE (AI) CONFIGURATION
# =============================================================================
# OpenAI Configuration
#
OPENAI_API_KEY=sk-your-openai-api-key-here

# Enable AI features
APP_AI_ENABLED=false

# OpenAI model to use
APP_AI_MODEL=gpt-4o-mini

# OpenAI API base URL
# APP_AI_BASE_URL=https://api.openai.com/v1

# OpenAI organization ID
# APP_AI_ORGANIZATION=org-your-organization

# OpenAI temperature (creativity level 0-2)
# APP_AI_TEMPERATURE=0.7

# Maximum tokens for response
# APP_AI_MAX_TOKENS=1000

# AI request timeout (milliseconds)
# APP_AI_TIMEOUT=30000

# AI rate limiting
# APP_AI_REQUESTS_PER_MINUTE=60

# =============================================================================
# FLYWAY DATABASE MIGRATION CONFIGURATION
# =============================================================================
# Flyway is enabled by default
#
spring.flyway.enabled=true

# Migration script locations
spring.flyway.locations=classpath:db/migration

# Baseline configuration (for existing databases)
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1

# Validation configuration
spring.flyway.validate-on-migrate=true
spring.flyway.out-of-order=false

# Clean disabled (prevents accidental data loss)
spring.flyway.clean-disabled=true

# Table name for schema history
# FLYWAY_TABLE=flyway_schema_history

# Schemas to manage
spring.flyway.schemas=public

# Placeholders for migrations
# FLYWAY_PLACEHOLDERS_ENVIRONMENT=production

# Migration retry count
# FLYWAY_RETRY_COUNT=3

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Application name and port
#
spring.application.name=meddelivery
server.port=8080

# Server context path (if deploying behind reverse proxy)
# server.servlet.context-path=/api

# Server compression
# server.compression.enabled=true
# server.compression.mime-types=application/json,application/xml,text/html,text/xml,text/plain,application/javascript,text/css

# Server SSL (if not using reverse proxy SSL termination)
# server.ssl.enabled=true
# server.ssl.key-store=classpath:keystore.p12
# server.ssl.key-store-password=changeit
# server.ssl.key-store-type=PKCS12
# server.ssl.key-alias=tomcat

# =============================================================================
# JPA / HIBERNATE CONFIGURATION
# =============================================================================
# Database schema generation
#
spring.jpa.hibernate.ddl-auto=none

# SQL logging
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# Database dialect
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Naming strategy
spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
spring.jpa.hibernate.naming.implicit-strategy=org.hibernate.boot.model.naming.ImplicitNamingStrategyLegacyJpaImpl

# Connection properties
spring.jpa.properties.hibernate.connection.provider_disables_autocommit=true
spring.jpa.properties.hibernate.jdbc.batch_size=20
spring.jpa.properties.hibernate.order_inserts=true
spring.jpa.properties.hibernate.order_updates=true
spring.jpa.properties.hibernate.jdbc.batch_versioned_data=true

# Cache settings
spring.jpa.properties.hibernate.cache.use_second_level_cache=true
spring.jpa.properties.hibernate.cache.use_query_cache=true
spring.jpa.properties.hibernate.cache.region.factory_class=org.hibernate.cache.jcache.JCacheRegionFactory

# Query settings
spring.jpa.properties.hibernate.default_batch_fetch_size=16
spring.jpa.properties.hibernate.jdbc.fetch_size=100
spring.jpa.properties.hibernate.jdbc.batch_size=50

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Root logging level
#
logging.level.root=INFO

# Application package logging
logging.level.com.meddelivery=INFO

# Framework logging
logging.level.org.springframework.web=WARN
logging.level.org.hibernate=WARN
logging.level.org.flywaydb=WARN
logging.level.org.springframework.security=WARN

# SQL logging (disable in production!)
# logging.level.org.hibernate.SQL=DEBUG
# logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE

# Log file configuration
logging.file.name=logs/meddelivery.log
logging.file.path=./logs

# Log pattern
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} - %msg%n
logging.pattern.file=%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n

# Log rotation
logging.logback.rollingpolicy.file-name-pattern=logs/meddelivery-%d{yyyy-MM-dd}.%i.log
logging.logback.rollingpolicy.max-file-size=10MB
logging.logback.rollingpolicy.max-history=30
logging.logback.rollingpolicy.total-size-cap=1GB

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Enable HTTPS redirect
#
# server.ssl.enabled=true

# Security headers
# spring.security.headers.content-type-options=true
# spring.security.headers.xss-protection=true
# spring.security.headers.frame-options=DENY
# spring.security.headers.content-security-policy=default-src 'self'

# Session management
# server.servlet.session.timeout=30m
# server.servlet.session.cookie.http-only=true
# server.servlet.session.cookie.secure=true

# CSRF protection
# spring.security.csrf.enabled=true

# Basic authentication fallback
# spring.security.user.name=admin
# spring.security.user.password=admin-password
# spring.security.user.roles=ADMIN

# =============================================================================
# METRICS & MONITORING
# =============================================================================
# Enable actuator endpoints
#
management.endpoints.web.exposure.include=health,info,metrics,prometheus
management.endpoint.health.show-details=always
management.endpoint.health.probes.enabled=true
management.endpoint.health.group.liveness.include=livenessState
management.endpoint.health.group.readiness.include=readinessState

# Metrics export
# management.metrics.export.prometheus.enabled=true
# management.metrics.tags.application=meddelivery

# Health indicators
management.health.db.enabled=true
management.health.redis.enabled=true
management.health.circuitbreakers.enabled=true
management.health.https.enabled=true

# Info endpoint
management.info.env.enabled=true
management.info.git.enabled=true
management.info.java.enabled=true

# =============================================================================
# RAILWAY SPECIFIC SETTINGS
# =============================================================================
# Railway environment detection
#
RAILWAY_ENVIRONMENT=production
RAILWAY_DEPLOYMENT_ID=auto-generated
RAILWAY_PROJECT_ID=your-project-id

# Railway PostgreSQL (use Railway's provided URL)
# DATABASE_URL=postgres://user:pass@host:port/database

# Railway Redis (use Railway's provided URL)
# REDIS_URL=redis://user:pass@host:port

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================
# Thread pool configuration
#
# Task executor
# spring.task.execution.pool.core-size=8
# spring.task.execution.pool.max-size=16
# spring.task.execution.pool.queue-capacity=100

# Task scheduler
# spring.task.scheduling.pool.size=10

# Async configuration
# spring.mvc.async.request-timeout=30000

# Connection timeouts
# spring.datasource.hikari.connection-timeout=30000
# spring.datasource.hikari.validation-timeout=5000
# spring.datasource.hikari.leak-detection-threshold=60000

# HTTP client timeouts
app.http.connect-timeout=5000
app.http.read-timeout=30000
app.http.write-timeout=5000

# Retry configuration
# spring.retry.max-attempts=3
# spring.retry.backoff.initial=1000
# spring.retry.backoff.multiplier=2.0

# Circuit breaker
# resilience4j.circuitbreaker.instances.default.failure-rate-threshold=50
# resilience4j.circuitbreaker.instances.default.minimum-number-of-calls=10
# resilience4j.circuitbreaker.instances.default.wait-duration-in-open-state=10000

# =============================================================================
# LOCAL DEVELOPMENT OVERRIDES
# =============================================================================
# Uncomment these for local development
#
# SPRING_PROFILES_ACTIVE=dev
# DB_URL=jdbc:postgresql://localhost:5432/meddelivery_dev
# DB_USERNAME=postgres
# DB_PASSWORD=password
# REDIS_HOST=localhost
# REDIS_PORT=6379
# JWT_SECRET=dev-secret-key-do-not-use-in-production
# LOGGING_LEVEL_COM_MEDDELIVERY=DEBUG
# LOGGING_LEVEL_ROOT=DEBUG

# =============================================================================
# NOTES
# =============================================================================
#
# 1. All sensitive values should be stored in Railway environment variables
#    for production deployments, not in this file.
#
# 2. This file is for local development and testing only.
#
# 3. Never commit this file with real values to version control.
#
# 4. Rotate all secrets immediately if this file is accidentally committed.
#
# 5. Use different values for different environments (dev, staging, prod).
#
# =============================================================================
# END OF CONFIGURATION
# =============================================================================

